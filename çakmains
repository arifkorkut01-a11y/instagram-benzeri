<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Set Prop - Ultimate Director's Cut (DM Avatar Customization)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        ig: {
                            darkbg: '#000000', darkcard: '#121212', darkborder: '#262626',
                            lightbg: '#ffffff', lightcard: '#fafafa', lightborder: '#dbdbdb',
                            blue: '#0095f6'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        @keyframes pulse-heart { 0% { transform: scale(1); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }
        .animate-heart { animation: pulse-heart 0.3s ease-in-out; }
        input:focus { outline: none; }
    </style>
</head>
<body class="bg-black sm:bg-gray-900 text-black dark:text-white font-sans antialiased select-none flex justify-center items-center min-h-screen m-0 p-0 overflow-hidden">

    <!-- Phone Wrapper Container -->
    <div id="app-container" class="w-full h-screen sm:w-[414px] sm:h-[844px] sm:rounded-[40px] sm:shadow-2xl bg-white dark:bg-ig-darkbg flex flex-col relative overflow-hidden border-0 sm:border-8 sm:border-gray-800 transition-colors duration-300">
        
        <!-- TOP APP BAR -->
        <header id="top-bar" class="h-14 border-b border-gray-200 dark:border-ig-darkborder flex items-center justify-between px-4 sticky top-0 bg-white/90 dark:bg-black/90 backdrop-blur-md z-30 flex-shrink-0">
            <!-- BRAND LOGO ONLY (SECRET ADMIN TRIGGER) -->
            <div class="flex items-center space-x-2 cursor-pointer h-full py-2" onclick="triggerSecretAdmin()">
                <div class="w-8 h-8 rounded-[9px] border-[2.5px] border-black dark:border-white flex items-center justify-center relative flex-shrink-0">
                    <div class="w-3.5 h-3.5 rounded-full border-[2.5px] border-black dark:border-white"></div>
                    <div class="w-1 h-1 bg-black dark:bg-white rounded-full absolute top-[2px] right-[2px]"></div>
                </div>
            </div>
            <!-- TOP RIGHT ICONS -->
            <div class="flex items-center space-x-5 text-2xl">
                <button onclick="switchTab('activity')" class="relative hover:opacity-75 transition">
                    <i class="fa-regular fa-heart"></i>
                    <span id="top-heart-badge" class="absolute top-0 right-0 bg-red-500 w-2.5 h-2.5 rounded-full hidden border-2 border-white dark:border-black"></span>
                </button>
                <button onclick="openDirectMessages()" class="relative hover:opacity-75 transition">
                    <i class="fa-brands fa-facebook-messenger"></i>
                    <span id="dm-badge" class="absolute -top-1 -right-2 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center hidden"></span>
                </button>
            </div>
        </header>

        <!-- MAIN SCROLLABLE CONTENT AREA -->
        <main id="main-content" class="flex-1 overflow-y-auto no-scrollbar relative pb-16">
            
            <!-- SECTION 1: FEED -->
            <div id="view-home" class="tab-view">
                <div class="py-3 border-b border-gray-200 dark:border-ig-darkborder overflow-x-auto no-scrollbar flex space-x-3 px-4 bg-white dark:bg-black">
                    <div class="flex flex-col items-center flex-shrink-0 cursor-pointer" onclick="showToast('Kamera kapalı')">
                        <div class="relative w-16 h-16 rounded-full p-[2px] bg-gray-200 dark:bg-gray-800">
                            <img id="feed-my-avatar" src="" class="w-full h-full object-cover rounded-full border-2 border-white dark:border-black">
                            <div class="absolute bottom-0 right-0 bg-ig-blue text-white rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold border-2 border-white dark:border-black">+</div>
                        </div>
                        <span class="text-xs mt-1 truncate w-16 text-center font-normal text-gray-500">Hikayen</span>
                    </div>
                    <div id="stories-tray-container" class="flex space-x-3"></div>
                </div>
                <div id="posts-feed-container" class="divide-y divide-gray-200 dark:divide-ig-darkborder pb-4"></div>
            </div>

            <!-- SECTION 2: SEARCH (ORGANİK DİNAMİK ARAMA) -->
            <div id="view-search" class="tab-view hidden pb-10 bg-white dark:bg-black min-h-full flex flex-col">
                <!-- Sabit Arama Çubuğu -->
                <div class="px-4 py-2 sticky top-0 bg-white dark:bg-black z-20 flex items-center space-x-3 border-b border-transparent transition-all">
                    <div class="relative flex-1 flex items-center bg-gray-100 dark:bg-zinc-800 rounded-xl transition-all h-10">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 text-gray-500 text-sm"></i>
                        <input type="text" id="frontend-search-input" placeholder="Ara" class="w-full h-full bg-transparent text-sm pl-9 pr-4 rounded-xl" oninput="handleFrontendSearch()">
                    </div>
                </div>

                <!-- Arama Sonuçları Alanı -->
                <div id="search-active-view" class="flex-1 flex flex-col w-full">
                    <div class="px-4 py-2 flex justify-between items-center border-b border-gray-200 dark:border-ig-darkborder">
                        <span id="search-header-text" class="text-sm font-bold">Yakınlardakiler</span>
                        <span id="search-clear-btn" class="text-xs text-ig-blue font-bold cursor-pointer" onclick="clearRecentSearches()">Tümünü Temizle</span>
                    </div>
                    <div id="search-results-container" class="flex-1 overflow-y-auto"></div>
                </div>
            </div>

            <!-- SECTION 3: TARGET PROFILE (HEDEF PROFİL) -->
            <div id="view-target-profile" class="tab-view hidden pb-10 bg-white dark:bg-black min-h-full">
                <div class="px-4 py-3 flex items-center border-b border-gray-200 dark:border-ig-darkborder sticky top-0 bg-white dark:bg-black z-10">
                    <button onclick="switchTab('search')" class="text-2xl mr-4"><i class="fa-solid fa-arrow-left"></i></button>
                    <h2 class="text-lg font-bold flex-1" id="tp-username-header">...</h2>
                    <i class="fa-solid fa-ellipsis text-xl"></i>
                </div>
                
                <div class="px-4 pt-3">
                    <div class="flex items-center justify-between mb-4">
                        <img id="tp-avatar" src="" class="w-20 h-20 rounded-full object-cover border border-gray-300 dark:border-ig-darkborder p-0.5">
                        <div class="flex justify-around flex-1 ml-6 text-center">
                            <div><div class="font-bold text-base" id="tp-posts-count">0</div><div class="text-xs text-gray-500">Gönderi</div></div>
                            <div><div class="font-bold text-base" id="tp-followers-count">0</div><div class="text-xs text-gray-500">Takipçi</div></div>
                            <div><div class="font-bold text-base" id="tp-following-count">0</div><div class="text-xs text-gray-500">Takip</div></div>
                        </div>
                    </div>
                    <div class="text-sm mb-4">
                        <span class="font-semibold block" id="tp-fullname">...</span>
                        <p class="text-black dark:text-white mt-0.5 whitespace-pre-line" id="tp-bio">...</p>
                    </div>
                    
                    <div class="flex space-x-2 mb-4" id="tp-action-buttons"></div>
                </div>

                <div class="border-t border-gray-200 dark:border-ig-darkborder flex justify-around text-gray-400">
                    <button class="flex-1 py-3 border-b-2 border-black dark:border-white text-black dark:text-white text-base flex justify-center"><i class="fa-solid fa-table-cells"></i></button>
                    <button class="flex-1 py-3 text-base flex justify-center"><i class="fa-solid fa-clapperboard"></i></button>
                    <button class="flex-1 py-3 text-base flex justify-center"><i class="fa-regular fa-user"></i></button>
                </div>
                <div id="tp-content-area" class="w-full"></div>
            </div>

            <!-- SECTION 4: ACTIVITY (BİLDİRİMLER) -->
            <div id="view-activity" class="tab-view hidden pb-10">
                <div class="px-4 py-3 border-b border-gray-200 dark:border-ig-darkborder sticky top-0 bg-white dark:bg-black z-10">
                    <h2 class="text-xl font-bold">Bildirimler</h2>
                </div>
                <div id="activity-list" class="flex-1 overflow-y-auto pt-2"></div>
            </div>

            <!-- SECTION 5: PROFILE (KENDİ PROFİLİM) -->
            <div id="view-profile" class="tab-view hidden pb-10">
                <div class="px-4 pt-3">
                    <div class="flex justify-between items-center mb-3">
                        <div class="flex items-center space-x-1">
                            <h2 class="text-lg font-bold" id="profile-username-header">azat_official</h2>
                            <i class="fa-solid fa-chevron-down text-xs ml-1"></i>
                        </div>
                        <div class="flex space-x-5 text-2xl">
                            <button onclick="showToast('Oluşturma kilitli')"><i class="fa-regular fa-square-plus"></i></button>
                            <button onclick="showToast('Ayarlar kilitli')"><i class="fa-solid fa-bars"></i></button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between mb-4">
                        <div class="relative">
                            <img id="profile-avatar-img" src="" class="w-20 h-20 rounded-full object-cover border border-gray-300 dark:border-ig-darkborder p-0.5">
                        </div>
                        <div class="flex justify-around flex-1 ml-6 text-center">
                            <div><div class="font-bold text-base" id="profile-posts-count">0</div><div class="text-xs text-gray-500">Gönderi</div></div>
                            <div><div class="font-bold text-base" id="profile-followers-count">0</div><div class="text-xs text-gray-500">Takipçi</div></div>
                            <div><div class="font-bold text-base" id="profile-following-count">0</div><div class="text-xs text-gray-500">Takip</div></div>
                        </div>
                    </div>
                    <div class="text-sm mb-3">
                        <span class="font-semibold block" id="profile-fullname">...</span>
                        <p class="text-black dark:text-white mt-0.5 whitespace-pre-line" id="profile-bio-text">...</p>
                    </div>
                    <div class="flex space-x-2 mb-4">
                        <button class="flex-1 bg-gray-200 dark:bg-ig-darkcard text-xs font-semibold py-1.5 rounded-lg border border-gray-300 dark:border-ig-darkborder">Profili Düzenle</button>
                        <button class="flex-1 bg-gray-200 dark:bg-ig-darkcard text-xs font-semibold py-1.5 rounded-lg border border-gray-300 dark:border-ig-darkborder">Profili Paylaş</button>
                        <button class="bg-gray-200 dark:bg-ig-darkcard px-3 rounded-lg border border-gray-300 dark:border-ig-darkborder"><i class="fa-solid fa-user-plus text-xs"></i></button>
                    </div>
                </div>

                <div class="border-t border-gray-200 dark:border-ig-darkborder flex justify-around text-gray-400">
                    <button class="flex-1 py-3 border-b-2 border-black dark:border-white text-black dark:text-white text-base flex justify-center"><i class="fa-solid fa-table-cells"></i></button>
                    <button class="flex-1 py-3 text-base flex justify-center"><i class="fa-solid fa-clapperboard"></i></button>
                    <button class="flex-1 py-3 text-base flex justify-center"><i class="fa-regular fa-user"></i></button>
                </div>
                <div id="profile-grid-container" class="grid grid-cols-3 gap-0.5"></div>
            </div>

        </main>

        <!-- BOTTOM NAVIGATION -->
        <nav class="h-12 border-t border-gray-200 dark:border-ig-darkborder bg-white dark:bg-black absolute bottom-0 left-0 right-0 z-30 flex items-center justify-around px-2 text-2xl flex-shrink-0 pb-1">
            <button onclick="switchTab('home')" class="nav-btn text-black dark:text-white p-2 transition-transform active:scale-90" data-tab="home"><i class="fa-solid fa-house"></i></button>
            <button onclick="switchTab('search')" class="nav-btn text-gray-500 p-2 transition-transform active:scale-90" data-tab="search"><i class="fa-solid fa-magnifying-glass"></i></button>
            <button onclick="showToast('Video sekmesi kapalı')" class="nav-btn text-gray-500 p-2 transition-transform active:scale-90"><i class="fa-solid fa-clapperboard"></i></button>
            
            <button onclick="switchTab('activity')" class="nav-btn text-gray-500 p-2 transition-transform active:scale-90 relative" data-tab="activity">
                <i class="fa-regular fa-heart"></i>
                <span id="bottom-heart-badge" class="absolute top-1.5 right-1.5 bg-red-500 w-2.5 h-2.5 rounded-full hidden border-2 border-white dark:border-black"></span>
            </button>
            
            <button onclick="switchTab('profile')" class="nav-btn text-gray-500 p-2 transition-transform active:scale-90" data-tab="profile">
                <img id="nav-avatar-img" src="" class="w-6 h-6 rounded-full object-cover border border-gray-400">
            </button>
        </nav>

        <!-- ==================== GİZLİ REJİ / SET YÖNETİM PANELİ ==================== -->
        <div id="settings-modal" class="fixed inset-0 bg-white dark:bg-zinc-900 z-50 hidden flex flex-col transition-transform duration-300 transform translate-y-full">
            <div class="bg-red-600 text-white p-3 flex justify-between items-center shadow-md">
                <div>
                    <h3 class="font-bold text-sm"><i class="fa-solid fa-video"></i> REJİ PANELİ</h3>
                    <span class="text-[10px] opacity-80">Değişiklikler anında cihaza kaydedilir.</span>
                </div>
                <div class="flex space-x-3">
                    <button onclick="toggleFullScreen()" class="bg-black/30 px-3 py-1 rounded text-xs font-bold"><i class="fa-solid fa-expand"></i> Tam Ekran</button>
                    <button onclick="closeSettingsModal()" class="text-lg"><i class="fa-solid fa-xmark"></i></button>
                </div>
            </div>

            <div class="flex overflow-x-auto no-scrollbar border-b border-zinc-300 dark:border-zinc-800 bg-gray-100 dark:bg-zinc-950 text-xs font-bold shadow-sm flex-shrink-0">
                <button onclick="switchSettingsTab('searchset')" class="settings-tab-btn px-4 py-3 text-red-600 border-b-2 border-red-600 whitespace-nowrap" data-target="set-searchset">Arama Ağı</button>
                <button onclick="switchSettingsTab('target')" class="settings-tab-btn px-4 py-3 text-gray-500 whitespace-nowrap" data-target="set-target">2. Profil (Hedef)</button>
                <button onclick="switchSettingsTab('profile')" class="settings-tab-btn px-4 py-3 text-gray-500 whitespace-nowrap" data-target="set-profile">Ana Profil</button>
                <button onclick="switchSettingsTab('notif')" class="settings-tab-btn px-4 py-3 text-gray-500 whitespace-nowrap" data-target="set-notif">Bildirimler</button>
                <button onclick="switchSettingsTab('feed')" class="settings-tab-btn px-4 py-3 text-gray-500 whitespace-nowrap" data-target="set-feed">Ana Akış</button>
                <button onclick="switchSettingsTab('myposts')" class="settings-tab-btn px-4 py-3 text-gray-500 whitespace-nowrap" data-target="set-myposts">Kendi Gönderim</button>
                <button onclick="switchSettingsTab('stories')" class="settings-tab-btn px-4 py-3 text-gray-500 whitespace-nowrap" data-target="set-stories">Hikayeler</button>
                <button onclick="switchSettingsTab('dms')" class="settings-tab-btn px-4 py-3 text-gray-500 whitespace-nowrap" data-target="set-dms">Mesajlar (DM)</button>
            </div>

            <div class="flex-1 overflow-y-auto pb-10">
                
                <!-- 1. ARAMA AĞI -->
                <div id="set-searchset" class="settings-section p-4 space-y-3">
                    <p class="text-xs text-gray-500 mb-2">Not: Arka planda 30+ gerçekçi sahte hesap var. Arama yapıldığında <b>EN ÜSTTE</b> çıkmasını istediğin ve tıklandığında açılacak olan <b>Hedef Kişi'yi</b> buradan ekle.</p>
                    <div class="bg-gray-100 dark:bg-zinc-800 p-3 rounded-lg border border-gray-300 dark:border-zinc-700 space-y-2">
                        <span class="font-bold block">Arama Sonucuna Yeni Hedef Ekle</span>
                        <input type="text" id="adm-srch-user" placeholder="Kullanıcı Adı (Örn: plaza_perisi)" class="w-full p-2 rounded bg-white dark:bg-black font-bold text-ig-blue">
                        <input type="text" id="adm-srch-full" placeholder="İsim Soyisim (Örn: Plaza Perisi)" class="w-full p-2 rounded bg-white dark:bg-black">
                        <div class="p-2 border border-dashed border-gray-400 rounded bg-white dark:bg-black flex items-center space-x-2">
                            <label class="text-[10px] text-gray-500 w-16">Avatar:</label>
                            <input type="file" accept="image/*" class="w-full text-[10px]" onchange="handleImageUpload(event, 'adm-srch-img')">
                            <input type="hidden" id="adm-srch-img">
                        </div>
                        <div class="flex items-center space-x-2 text-xs font-bold text-gray-700 dark:text-gray-300">
                            <input type="checkbox" id="adm-srch-istarget" checked class="w-4 h-4 text-ig-blue"> 
                            <label>Tıklayınca 2. Profile (Hedef Profil) Gitsin</label>
                        </div>
                        <button onclick="adminAddSearchResult()" class="w-full bg-green-600 text-white py-2 rounded font-bold">Arama Listesine Ekle</button>
                    </div>
                    <div id="admin-search-list" class="space-y-2 mt-4"></div>
                </div>

                <!-- 2. HEDEF PROFIL (TARGET) -->
                <div id="set-target" class="settings-section hidden p-4 space-y-3">
                    <div class="bg-blue-50 dark:bg-blue-900/20 p-3 rounded-lg border border-blue-300 dark:border-blue-700 space-y-3">
                        <span class="block font-bold text-blue-600 dark:text-blue-400 mb-1 text-xs"><i class="fa-solid fa-bullseye"></i> 2. PROFİL DAVRANIŞ AYARLARI</span>
                        <div class="flex items-center space-x-2 text-sm font-bold text-gray-700 dark:text-gray-300">
                            <input type="checkbox" id="adm-tp-private" class="w-4 h-4" onchange="updateTargetProfileLive()">
                            <label>Gizli Hesap (Kilit İkonu Çıkar)</label>
                        </div>
                        <div>
                            <label class="block text-gray-500 text-xs mb-1">Takip Butonu Başlangıç Durumu</label>
                            <select id="adm-tp-state" class="w-full p-2 rounded bg-white dark:bg-black font-bold border border-gray-300 dark:border-zinc-600" onchange="updateTargetProfileLive()">
                                <option value="0">Takip Et (Mavi Buton)</option>
                                <option value="1">İstek Gönderildi (Gri Buton)</option>
                                <option value="2">Takip Ediliyor (Gri Buton)</option>
                            </select>
                        </div>
                    </div>

                    <div class="bg-gray-100 dark:bg-zinc-800 p-3 rounded-lg border border-gray-300 dark:border-zinc-700 space-y-2">
                        <h4 class="font-bold text-gray-700 dark:text-gray-300">Hedef Profil Bilgileri</h4>
                        <div><label class="block text-gray-500 mb-1 text-xs">Kullanıcı Adı</label><input type="text" id="tp-inp-user" class="w-full p-1.5 rounded bg-white dark:bg-black font-bold" oninput="updateTargetProfileLive()"></div>
                        <div><label class="block text-gray-500 mb-1 text-xs">İsim Soyisim</label><input type="text" id="tp-inp-full" class="w-full p-1.5 rounded bg-white dark:bg-black" oninput="updateTargetProfileLive()"></div>
                        <div><label class="block text-gray-500 mb-1 text-xs">Biyografi</label><textarea id="tp-inp-bio" class="w-full p-1.5 rounded bg-white dark:bg-black h-12" oninput="updateTargetProfileLive()"></textarea></div>
                        <div class="p-2 border border-dashed border-gray-400 rounded bg-white dark:bg-black">
                            <label class="block text-[10px] mb-1 text-gray-500">Profil Fotoğrafı Seç</label>
                            <input type="file" accept="image/*" class="w-full text-xs" onchange="handleImageUpload(event, 'tp-inp-avatar')">
                            <input type="hidden" id="tp-inp-avatar" oninput="updateTargetProfileLive()">
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div><label class="block text-gray-500 mb-1 text-xs">Gönderi</label><input type="text" id="tp-inp-pcount" class="w-full p-1.5 rounded bg-white dark:bg-black text-center" oninput="updateTargetProfileLive()"></div>
                            <div><label class="block text-gray-500 mb-1 text-xs">Takipçi</label><input type="text" id="tp-inp-fwer" class="w-full p-1.5 rounded bg-white dark:bg-black text-center" oninput="updateTargetProfileLive()"></div>
                            <div><label class="block text-gray-500 mb-1 text-xs">Takip</label><input type="text" id="tp-inp-fwing" class="w-full p-1.5 rounded bg-white dark:bg-black text-center" oninput="updateTargetProfileLive()"></div>
                        </div>
                    </div>

                    <div class="bg-gray-100 dark:bg-zinc-800 p-3 rounded-lg border border-gray-300 dark:border-zinc-700 space-y-2">
                        <span class="font-bold block text-sm">Hedef Profil Fotoğraf Izgarası (Grid)</span>
                        <div class="flex items-center space-x-2">
                            <input type="file" accept="image/*" class="w-full text-[10px]" onchange="handleImageUpload(event, 'tp-new-post-img')">
                            <input type="hidden" id="tp-new-post-img">
                            <button onclick="addTPGridImage()" class="bg-ig-blue text-white px-3 py-1 rounded font-bold text-xs">Ekle</button>
                        </div>
                        <div id="tp-admin-grid-list" class="grid grid-cols-4 gap-1 mt-2"></div>
                    </div>
                </div>

                <!-- 3. ANA PROFIL (MAIN PROFILE) -->
                <div id="set-profile" class="settings-section hidden p-4 space-y-3">
                    <div class="bg-gray-100 dark:bg-zinc-800 p-3 rounded-lg border border-gray-300 dark:border-zinc-700 space-y-2">
                        <div><label class="block text-gray-500 mb-1">Oyuncu Kullanıcı Adı</label><input type="text" id="inp-username" class="w-full p-2 rounded bg-white dark:bg-black font-bold text-red-500" oninput="updateProfileLive()"></div>
                        <div><label class="block text-gray-500 mb-1">İsim Soyisim</label><input type="text" id="inp-fullname" class="w-full p-2 rounded bg-white dark:bg-black" oninput="updateProfileLive()"></div>
                        <div><label class="block text-gray-500 mb-1">Biyografi</label><textarea id="inp-bio" class="w-full p-2 rounded bg-white dark:bg-black h-16" oninput="updateProfileLive()"></textarea></div>
                        <div class="p-2 border border-dashed border-gray-400 rounded bg-white dark:bg-black">
                            <label class="block text-[10px] mb-1 text-gray-500">Profil Fotoğrafı Seç</label>
                            <input type="file" accept="image/*" class="w-full text-xs" onchange="handleImageUpload(event, 'inp-avatar')">
                            <input type="hidden" id="inp-avatar" oninput="updateProfileLive()">
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div><label class="block text-gray-500 mb-1">Gönderi</label><input type="text" id="inp-pcount" class="w-full p-2 rounded bg-white dark:bg-black text-center" oninput="updateProfileLive()"></div>
                            <div><label class="block text-gray-500 mb-1">Takipçi</label><input type="text" id="inp-followers" class="w-full p-2 rounded bg-white dark:bg-black text-center" oninput="updateProfileLive()"></div>
                            <div><label class="block text-gray-500 mb-1">Takip</label><input type="text" id="inp-following" class="w-full p-2 rounded bg-white dark:bg-black text-center" oninput="updateProfileLive()"></div>
                        </div>
                    </div>
                    <div class="flex space-x-2 pt-2">
                        <button onclick="toggleDarkMode()" class="flex-1 bg-black text-white dark:bg-white dark:text-black py-2 rounded font-bold">Tema Değiştir</button>
