                document.getElementById('edit-post-title').innerText = "Yeni Gönderi Ekle";
                
                if(returnTab === 'myposts') {
                    document.getElementById('edit-post-user').value = appData.profile.username;
                    document.getElementById('edit-user-container').classList.add('hidden');
                } else {
                    document.getElementById('edit-post-user').value = "kullanici_adi";
                    document.getElementById('edit-user-container').classList.remove('hidden');
                    document.getElementById('edit-post-avatar').value = '';
                    document.getElementById('edit-post-avatar-preview').src = 'https://placehold.co/100x100/333/fff?text=Seç';
                }
                
                document.getElementById('edit-post-img').value = '';
                document.getElementById('edit-post-preview').src = 'https://placehold.co/100x100/333/fff?text=Sec';
                document.getElementById('edit-post-likes').value = 100;
                document.getElementById('edit-post-time').value = 'Şimdi';
                document.getElementById('edit-post-loc').value = 'Film Seti';
                document.getElementById('edit-post-cap').value = '';
                document.getElementById('edit-post-comments-section').classList.add('hidden'); 
            } else {
                activeEditPostId = postId;
                const post = appData.posts.find(p => p.id === postId);
                document.getElementById('edit-post-title').innerText = "Gönderiyi Düzenle";
                document.getElementById('edit-post-user').value = post.username;
                
                if(post.username === appData.profile.username) {
                    document.getElementById('edit-user-container').classList.add('hidden');
                } else {
                    document.getElementById('edit-user-container').classList.remove('hidden');
                    document.getElementById('edit-post-avatar').value = post.avatar;
                    document.getElementById('edit-post-avatar-preview').src = post.avatar;
                }
                
                document.getElementById('edit-post-img').value = post.image;
                document.getElementById('edit-post-preview').src = post.image;
                document.getElementById('edit-post-likes').value = post.likes;
                document.getElementById('edit-post-time').value = post.time || '2 saat önce';
                document.getElementById('edit-post-loc').value = post.location;
                document.getElementById('edit-post-cap').value = post.caption;
                
                document.getElementById('edit-post-comments-section').classList.remove('hidden');
                renderAdminComments();
            }
        }

        function closePostEditView() {
            document.getElementById('admin-post-edit-view').classList.add('hidden');
            document.getElementById(`set-${activeReturnTab}`).classList.remove('hidden');
        }

        function saveAdminPost() {
            const user = document.getElementById('edit-post-user').value || appData.profile.username;
            const img = document.getElementById('edit-post-img').value;
            const likes = parseInt(document.getElementById('edit-post-likes').value) || 0;
            const time = document.getElementById('edit-post-time').value || 'Şimdi';
            const loc = document.getElementById('edit-post-loc').value || '';
            const cap = document.getElementById('edit-post-cap').value || '';

            if(!img) return showToast('Lütfen Görsel Seçin!');

            let avatarUrl = 'https://placehold.co/150/555/fff';
            if (user === appData.profile.username) {
                avatarUrl = appData.profile.avatar;
            } else {
                const customAvatar = document.getElementById('edit-post-avatar').value;
                if (customAvatar) {
                    avatarUrl = customAvatar;
                } else if (activeEditPostId !== null) {
                    const oldPost = appData.posts.find(p => p.id === activeEditPostId);
                    if (oldPost) avatarUrl = oldPost.avatar;
                } else {
                    avatarUrl = `https://randomuser.me/api/portraits/women/${Math.floor(Math.random()*90)}.jpg`;
                }
            }

            if (activeEditPostId === null) {
                appData.posts.unshift({
                    id: Date.now(), username: user, avatar: avatarUrl, location: loc,
                    image: img, likes: likes, isLiked: false, caption: cap, time: time, comments: []
                });
                showToast('Gönderi Eklendi!');
            } else {
                const post = appData.posts.find(p => p.id === activeEditPostId);
                post.username = user; post.avatar = avatarUrl; post.image = img;
                post.likes = likes; post.time = time; post.location = loc; post.caption = cap;
                showToast('Gönderi Güncellendi!');
            }
            saveData(); renderAll(); closePostEditView();
        }

        function renderAdminComments() {
            const post = appData.posts.find(p => p.id === activeEditPostId);
            const list = document.getElementById('edit-post-comments-list');
            if (post.comments.length === 0) {
                list.innerHTML = `<div class="text-xs text-gray-500">Henüz yorum yok.</div>`; return;
            }
            list.innerHTML = post.comments.map((c, i) => `
                <div class="flex justify-between items-start bg-gray-100 dark:bg-black p-1.5 rounded">
                    <div class="text-xs"><span class="font-bold">${c.user}</span> ${c.text}</div>
                    <button onclick="deleteAdminComment(${i})" class="text-red-500 ml-2"><i class="fa-solid fa-xmark"></i></button>
                </div>
            `).join('');
        }

        function addAdminComment() {
            const user = document.getElementById('new-comment-user').value || 'hayran_1';
            const text = document.getElementById('new-comment-text').value;
            if(!text) return;
            appData.posts.find(p => p.id === activeEditPostId).comments.push({ user: user, text: text });
            document.getElementById('new-comment-text').value = '';
            saveData(); renderAll(); renderAdminComments();
        }

        function deleteAdminComment(index) {
            appData.posts.find(p => p.id === activeEditPostId).comments.splice(index, 1);
            saveData(); renderAll(); renderAdminComments();
        }

        // --- 9. ADMIN OTHERS (NOTIF, STORY, DM) ---
        function adminAddActivity() {
            const user = document.getElementById('adm-notif-user').value || 'yeni_kullanici';
            const txt = document.getElementById('adm-notif-text').value || 'fotoğrafını beğendi.';
            const time = document.getElementById('adm-notif-time').value || '1s';
            appData.activities.unshift({ id: Date.now(), user: user, avatar: `https://randomuser.me/api/portraits/women/${Math.floor(Math.random()*90)}.jpg`, text: txt, time: time });
            appData.notifications.showHeartBadge = true;
            document.getElementById('adm-notif-heart').checked = true;
            saveData(); renderAll(); showToast('Bildirim Gönderildi!');
        }

        function adminAddStory() {
            const user = document.getElementById('adm-story-user').value || 'rol_arkadasi';
            const avatar = document.getElementById('adm-story-avatar').value || `https://randomuser.me/api/portraits/women/${Math.floor(Math.random()*90)}.jpg`;
            const img = document.getElementById('adm-story-img').value;
            if(!img) return showToast('Lütfen Hikaye Görseli Seçin!');
            appData.stories.unshift({ id: Date.now(), name: user, avatar: avatar, image: img, seen: false });
            document.getElementById('adm-story-img').value = '';
            saveData(); renderAll(); showToast('Hikaye eklendi!');
        }

        function adminAddDM() {
            const user = document.getElementById('adm-dm-user').value || 'gizli_numara';
            const msg = document.getElementById('adm-dm-msg').value || 'Selam!';
            const avatar = document.getElementById('adm-dm-avatar').value || `https://randomuser.me/api/portraits/women/${Math.floor(Math.random()*90)}.jpg`;
            const unread = document.getElementById('adm-dm-unread').checked;
            
            appData.dms.unshift({ user: user, avatar: avatar, lastMsg: msg, time: 'Şimdi', unread: unread });
            document.getElementById('adm-dm-avatar').value = '';
            saveData(); renderAll(); showToast('Mesaj eklendi!');
        }

        function deleteItem(type, id) {
            if(type === 'post') appData.posts = appData.posts.filter(p => p.id !== id);
            if(type === 'story') appData.stories = appData.stories.filter(s => s.id !== id);
            if(type === 'dm') appData.dms.splice(id, 1);
            if(type === 'activity') appData.activities.splice(id, 1);
            saveData(); renderAll();
        }

        // --- 10. FRONTEND MODALS ---
        function openCommentsModal(postId) {
            activePostIdForComments = postId;
            const post = appData.posts.find(p => p.id === postId);
            const list = document.getElementById('comments-list');
            if(post.comments.length > 0) {
                list.innerHTML = post.comments.map((c, idx) => `
                    <div class="flex items-start space-x-3 mb-4 text-sm">
                        <img src="https://randomuser.me/api/portraits/women/${Math.abs((idx+10)*5 % 90)}.jpg" class="w-8 h-8 rounded-full object-cover">
                        <div><span class="font-bold mr-1">${c.user}</span><span>${c.text}</span></div>
                    </div>
                `).join('');
            } else {
                list.innerHTML = `<div class="text-center text-gray-500 text-sm mt-10">Henüz yorum yok.<br>İlk yorumu sen yap.</div>`;
            }
            document.getElementById('comments-modal').classList.remove('hidden');
        }
        function closeCommentsModal() { document.getElementById('comments-modal').classList.add('hidden'); }
        
        function postCommentFrontend() {
            const input = document.getElementById('comment-input');
            const txt = input.value.trim();
            if(txt && activePostIdForComments) {
                appData.posts.find(p => p.id === activePostIdForComments).comments.push({ user: appData.profile.username, text: txt });
                input.value = ''; saveData(); renderFeed(); openCommentsModal(activePostIdForComments);
            }
        }

        function openStory(id) {
            const s = appData.stories.find(x => x.id === id);
            if (!s) return;
            s.seen = true; saveData(); renderStories();
            document.getElementById('modal-story-avatar').src = s.avatar;
            document.getElementById('modal-story-username').innerText = s.name;
            document.getElementById('modal-story-img').src = s.image;
            document.getElementById('story-modal').classList.remove('hidden');
            
            const pCont = document.getElementById('story-progress-container');
            pCont.innerHTML = `<div class="bg-white/30 h-0.5 w-full rounded overflow-hidden"><div id="story-prog" class="bg-white h-full w-0"></div></div>`;
            setTimeout(() => { document.getElementById('story-prog').style.transition = "width 4s linear"; document.getElementById('story-prog').style.width = "100%"; }, 50);

            clearTimeout(activeStoryTimer);
            activeStoryTimer = setTimeout(() => { closeStoryModal(); }, 4000);
        }
        function closeStoryModal() {
            document.getElementById('story-modal').classList.add('hidden');
            clearTimeout(activeStoryTimer);
        }

        // --- 11. UI TAB NAVIGATION ---
        function switchSettingsTab(tabName) {
            document.querySelectorAll('.settings-section').forEach(sec => sec.classList.add('hidden'));
            document.getElementById('admin-post-edit-view').classList.add('hidden'); 
            document.getElementById(`set-${tabName}`).classList.remove('hidden');

            document.querySelectorAll('.settings-tab-btn').forEach(btn => {
                btn.classList.remove('border-b-2', 'border-red-600', 'text-red-600');
                btn.classList.add('text-gray-500');
            });
            const activeBtn = document.querySelector(`.settings-tab-btn[data-target="set-${tabName}"]`);
            if (activeBtn) {
                activeBtn.classList.add('border-b-2', 'border-red-600', 'text-red-600');
                activeBtn.classList.remove('text-gray-500');
                activeBtn.scrollIntoView({ behavior: 'smooth', inline: 'center' });
            }
        }

        function switchTab(tabName) {
            document.querySelectorAll('.tab-view').forEach(el => el.classList.add('hidden'));
            document.getElementById(`view-${tabName}`).classList.remove('hidden');
            
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-black', 'dark:text-white');
                btn.classList.add('text-gray-500');
            });
            const activeBtn = document.querySelector(`.nav-btn[data-tab="${tabName}"]`);
            if(activeBtn) {
                activeBtn.classList.add('text-black', 'dark:text-white');
                activeBtn.classList.remove('text-gray-500');
            }

            if(tabName === 'activity' && appData.notifications.showHeartBadge) {
                appData.notifications.showHeartBadge = false;
                document.getElementById('adm-notif-heart').checked = false;
                saveData(); renderAll();
            }
            if(tabName === 'search') {
                const input = document.getElementById('frontend-search-input');
                input.value = '';
                renderSearchList(''); 
            }
        }

        function openDirectMessages() { document.getElementById('dm-modal').classList.remove('hidden'); }
        function closeDirectMessages() { document.getElementById('dm-modal').classList.add('hidden'); }
        function toggleDarkMode() { document.documentElement.classList.toggle('dark'); }
        
        function showToast(msg) {
            const t = document.getElementById('toast');
            t.innerText = msg; t.classList.remove('hidden');
            setTimeout(() => t.classList.add('hidden'), 2000);
        }
    </script>
</body>
</html>
