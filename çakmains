        function handleFrontendSearch() {
            const query = document.getElementById('frontend-search-input').value.trim();
            const container = document.getElementById('search-results-container');
            const clearBtn = document.getElementById('search-clear-btn');
            
            if (query.length > 0) {
                container.innerHTML = `<div class="flex justify-center py-6"><i class="fa-solid fa-spinner fa-spin text-gray-400 text-xl"></i></div>`;
                document.getElementById('search-header-text').innerText = 'Sonuçlar';
                clearBtn.classList.add('hidden');
            } else {
                document.getElementById('search-header-text').innerText = 'Yakınlardakiler';
                if (appData.recentSearches.length > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
                
                renderSearchList('');
                return;
            }

            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => { renderSearchList(query); }, 150);
        }
        
        function renderSearchList(query = '') {
            query = query.toLowerCase();
            let results = [];
            let isRecent = !query;

            if (isRecent) {
                results = appData.recentSearches || [];
                const clearBtn = document.getElementById('search-clear-btn');
                if (results.length > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            } else {
                let combinedDB = [...appData.searchList, ...DUMMY_DB];
                let matched = combinedDB.filter(r => r.user.toLowerCase().includes(query) || (r.full && r.full.toLowerCase().includes(query)));
                matched.sort((a, b) => (b.isTarget ? 1 : 0) - (a.isTarget ? 1 : 0));
                results = matched.slice(0, 15);
            }

            const container = document.getElementById('search-results-container');

            if (results.length === 0) {
                container.innerHTML = `<div class="text-center text-gray-500 text-sm mt-8">${isRecent ? 'Yakınlarda arama yok.' : 'Sonuç bulunamadı.'}</div>`;
                return;
            }

            container.innerHTML = results.map(r => `
                <div class="flex items-center space-x-3 px-4 py-3 active:bg-gray-200 dark:active:bg-zinc-800 transition cursor-pointer" 
                     onclick="handleSearchResultClick('${r.user}')">
                    <div class="w-14 h-14 rounded-full p-[1px] border border-gray-300 dark:border-zinc-700 flex-shrink-0">
                        <img src="${r.avatar}" class="w-full h-full rounded-full object-cover">
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <span class="block font-bold text-sm leading-tight truncate">${r.user}</span>
                        <span class="block text-gray-500 text-sm leading-tight truncate">${r.full}</span>
                    </div>
                    ${isRecent ? `<button onclick="event.stopPropagation(); removeRecentSearch('${r.user}');" class="text-gray-400 p-2 active:scale-90 transition text-lg"><i class="fa-solid fa-xmark"></i></button>` : ''}
                </div>
            `).join('');
        }

        function handleSearchResultClick(username) {
            const item = [...appData.searchList, ...DUMMY_DB].find(x => x.user === username);
            if (!item) return;

            if (!appData.recentSearches) appData.recentSearches = [];
            appData.recentSearches = appData.recentSearches.filter(r => r.user !== username);
            appData.recentSearches.unshift(item);
            
            if (appData.recentSearches.length > 10) appData.recentSearches.pop();
            saveData();

            if (item.isTarget) { switchTab('target-profile'); } 
            else { showToast("Bu profile erişilemiyor."); }
        }

